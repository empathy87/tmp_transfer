+    @Test
+    void testLiveCheckpointIntervalUpdateDoesNotRestartJob(
+            @InjectClusterClient RestClusterClient<?> restClusterClient) throws Exception {
+        final JobID jobId = submitInfiniteCheckpointingJob(restClusterClient);
+        try {
+            CommonTestUtils.waitUntilCondition(() -> runningTasks(restClusterClient, jobId) == 1);
+
+            // Config-native body: keys/values as in config.yaml, parsed by Flink's config parser.
+            final Map<String, String> intervalUpdate = new HashMap<>();
+            intervalUpdate.put("execution.checkpointing.interval", "1 s");
+
+            final Set<String> attemptsBefore = runningAttempts(restClusterClient, jobId);
+            assertThat(attemptsBefore).hasSize(1);
+
+            final JsonNode before = effectiveCheckpointConfig(restClusterClient, jobId);
+            assertThat(before.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_INTERVAL).asLong())
+                    .isEqualTo(30_000L);
+
+            restClusterClient
+                    .updateCheckpointConfiguration(
+                            jobId, new CheckpointConfigUpdateRequestBody(intervalUpdate))
+                    .get();
+
+            final JsonNode after =
+                    awaitCheckpointConfig(
+                            restClusterClient,
+                            jobId,
+                            node ->
+                                    node.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_INTERVAL)
+                                                    .asLong()
+                                            == 1_000L);
+            assertThat(after.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_TIMEOUT).asLong())
+                    .as("a parameter the request omitted must not have moved")
+                    .isEqualTo(
+                            before.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_TIMEOUT)
+                                    .asLong());
+            assertThat(after.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_MIN_PAUSE).asLong())
+                    .isEqualTo(
+                            before.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_MIN_PAUSE)
+                                    .asLong());
+            assertThat(
+                            after.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_MAX_CONCURRENT)
+                                    .asLong())
+                    .isEqualTo(
+                            before.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_MAX_CONCURRENT)
+                                    .asLong());
+
+            assertStaysRunningWithoutRestart(restClusterClient, jobId, attemptsBefore);
+        } finally {
+            restClusterClient.cancel(jobId).join();
+        }
+    }
