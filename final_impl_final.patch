+import org.apache.flink.util.concurrent.FutureUtils;
+
+import org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus;
+
+import org.junit.After;
+import org.junit.Test;
+
+import java.util.Collection;
+import java.util.Collections;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/** Tests for live checkpoint configuration updates at the {@link Dispatcher}. */
+public class DispatcherCheckpointConfigUpdateTest extends AbstractDispatcherTest {
+
+    private static final CheckpointConfigUpdate PARTIAL_UPDATE =
+            CheckpointConfigUpdate.builder().setCheckpointInterval(5_000L).build();
+
+    private TestingDispatcher dispatcher;
+    private JobGraph jobGraph;
+
+    @After
+    public void tearDown() throws Exception {
+        if (dispatcher != null) {
+            RpcUtils.terminateRpcEndpoint(dispatcher);
+        }
+        super.tearDown();
+    }
+
+    @Test
+    public void testUpdateIsForwardedToTheRunningJob() throws Exception {
+        final CompletableFuture<CheckpointConfigUpdate> received = new CompletableFuture<>();
+        startDispatcher(
+                gateway(
+                        update -> {
+                            received.complete(update);
+                            return CompletableFuture.completedFuture(Acknowledge.get());
+                        }));
+
+        assertThat(update().get()).isEqualTo(Acknowledge.get());
+        assertThat(received.get()).isEqualTo(PARTIAL_UPDATE);
+    }
+
+    @Test
+    public void testRuntimeApplicationFailureIsPropagated() throws Exception {
+        final JobNotExecutingException applyFailure =
+                new JobNotExecutingException("the job is not currently executing");
+        startDispatcher(gateway(ignored -> FutureUtils.completedExceptionally(applyFailure)));
+
+        assertThatThrownBy(() -> update().get()).cause().isSameAs(applyFailure);
+    }
+
+    @Test
+    public void testConsecutiveUpdatesAreAccepted() throws Exception {
+        startDispatcher(gateway(ignored -> CompletableFuture.completedFuture(Acknowledge.get())));
+
+        update().get();
+        update().get();
+    }
+
+    @Test
+    public void testUpdateIsRejectedWhileTheFeatureIsDisabled() throws Exception {
+        final AtomicBoolean reachedTheJob = new AtomicBoolean();
+        final Configuration configuration = new Configuration();
+        configuration.set(JobManagerOptions.DYNAMIC_CONFIGURATION_ENABLED, false);
+        startDispatcher(
+                gateway(
+                        ignored -> {
+                            reachedTheJob.set(true);
+                            return CompletableFuture.completedFuture(Acknowledge.get());
+                        }),
+                configuration);
+
+        assertThatThrownBy(() -> update().get())
+                .cause()
+                .isInstanceOfSatisfying(
+                        RestHandlerException.class,
+                        e ->
+                                assertThat(e.getHttpResponseStatus())
+                                        .isEqualTo(HttpResponseStatus.FORBIDDEN));
+
+        assertThat(reachedTheJob)
+                .as("the running job must not be asked to apply a disabled update")
+                .isFalse();
+    }
+
+    // ------------------------------------------------------------------------------------------
+
+    private CompletableFuture<Acknowledge> update() {
+        return dispatcher
+                .getSelfGateway(DispatcherGateway.class)
+                .updateCheckpointConfiguration(jobGraph.getJobID(), PARTIAL_UPDATE);
+    }
+
+    private static TestingJobMasterGateway gateway(
+            java.util.function.Function<CheckpointConfigUpdate, CompletableFuture<Acknowledge>>
+                    applyFunction) {
+        return new TestingJobMasterGatewayBuilder()
+                .setApplyCheckpointConfigUpdateFunction(applyFunction)
+                .build();
+    }
+
+    private void startDispatcher(TestingJobMasterGateway gateway) throws Exception {
+        final Configuration configuration = new Configuration();
+        configuration.set(JobManagerOptions.DYNAMIC_CONFIGURATION_ENABLED, true);
+        startDispatcher(gateway, configuration);
+    }
+
+    private void startDispatcher(TestingJobMasterGateway gateway, Configuration configuration)
+            throws Exception {
+        jobGraph = JobGraphTestUtils.emptyJobGraph();
+        final TestingJobGraphStore jobGraphStore =
+                TestingJobGraphStore.newBuilder()
+                        .setInitialJobGraphs(Collections.singleton(jobGraph))
+                        .build();
+        jobGraphStore.start(null);
+        dispatcher =
+                createTestingDispatcherBuilder()
+                        .setConfiguration(configuration)
+                        .setJobGraphWriter(jobGraphStore)
+                        .setJobManagerRunnerFactory(
+                                new TestingJobMasterGatewayJobManagerRunnerFactory(gateway))
+                        .build(rpcService);
+        dispatcher.start();
+        dispatcher.getSelfGateway(DispatcherGateway.class).submitJob(jobGraph, TIMEOUT).get();
+    }
+
+    /** Hands the Dispatcher a JobMaster gateway the test supplies. */
+    private static final class TestingJobMasterGatewayJobManagerRunnerFactory
+            extends TestingJobMasterServiceLeadershipRunnerFactory {
+        private final TestingJobMasterGateway testingJobMasterGateway;
+
+        private TestingJobMasterGatewayJobManagerRunnerFactory(
+                TestingJobMasterGateway testingJobMasterGateway) {
+            this.testingJobMasterGateway = testingJobMasterGateway;
+        }
+
+        @Override
+        public TestingJobManagerRunner createJobManagerRunner(
+                JobGraph jobGraph,
+                Configuration configuration,
+                RpcService rpcService,
+                HighAvailabilityServices highAvailabilityServices,
+                HeartbeatServices heartbeatServices,
+                JobManagerSharedServices jobManagerServices,
+                JobManagerJobMetricGroupFactory jobManagerJobMetricGroupFactory,
+                FatalErrorHandler fatalErrorHandler,
+                Collection<FailureEnricher> failureEnrichers,
+                long initializationTimestamp)
+                throws Exception {
+            final TestingJobManagerRunner runner =
+                    super.createJobManagerRunner(
+                            jobGraph,
+                            configuration,
+                            rpcService,
+                            highAvailabilityServices,
+                            heartbeatServices,
+                            jobManagerServices,
+                            jobManagerJobMetricGroupFactory,
+                            fatalErrorHandler,
+                            failureEnrichers,
+                            initializationTimestamp);
+            runner.completeJobMasterGatewayFuture(testingJobMasterGateway);
+            return runner;
+        }
+    }
+}
