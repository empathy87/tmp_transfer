+        assertThatThrownBy(() -> applyPartialUpdate(scheduler, completeConfiguration()))
+                .cause()
+                .isInstanceOf(CheckpointingNotEnabledException.class)
+                .hasMessageContaining("checkpointing is not enabled");
+    }
+
+    private static CheckpointConfigUpdate completeConfiguration() {
+        return CheckpointConfigUpdate.builder()
+                .setCheckpointInterval(1_000L)
+                .setCheckpointIntervalDuringBacklog(1_000L)
+                .setCheckpointTimeout(60_000L)
+                .setMinPauseBetweenCheckpoints(0L)
+                .setMaxConcurrentCheckpoints(1)
+                .setTolerableCheckpointFailureNumber(0)
+                .setAlignedCheckpointTimeout(0L)
+                .build();
+    }
+
+    private void applyPartialUpdate(AdaptiveScheduler scheduler, CheckpointConfigUpdate partial)
+            throws Exception {
+        CompletableFuture.runAsync(
+                        () -> scheduler.applyCheckpointConfigUpdate(partial),
+                        singleThreadMainThreadExecutor)
+                .get();
+    }
+
+    /** Unlike a translated JobGraph, {@code enableCheckpointing} leaves the backlog at 10 ms. */
+    private static void alignBacklogIntervalWithInterval(JobGraph jobGraph) {
+        final JobCheckpointingSettings settings = jobGraph.getCheckpointingSettings();
+        final CheckpointCoordinatorConfiguration configuration =
+                settings.getCheckpointCoordinatorConfiguration();
+        jobGraph.setSnapshotSettings(
+                new JobCheckpointingSettings(
+                        configuration
+                                .toBuilder()
+                                .setCheckpointIntervalDuringBacklog(
+                                        configuration.getCheckpointInterval())
+                                .build(),
+                        settings.getDefaultStateBackend(),
+                        settings.isChangelogStateBackendEnabled(),
+                        settings.getDefaultCheckpointStorage(),
+                        settings.getMasterHooks()));
+    }
+
+    private CheckpointCoordinator checkpointCoordinatorOf(AdaptiveScheduler scheduler)
+            throws Exception {
+        return CompletableFuture.supplyAsync(
+                        () ->
+                                ((StateWithExecutionGraph) scheduler.getState())
+                                        .getExecutionGraph()
+                                        .getCheckpointCoordinator(),
+                        singleThreadMainThreadExecutor)
+                .get();
+    }
+
+    private CheckpointCoordinatorConfiguration checkpointConfigurationOf(
+            AdaptiveScheduler scheduler) throws Exception {
+        return CompletableFuture.supplyAsync(
+                        () ->
+                                scheduler
+                                        .requestJob()
+                                        .getArchivedExecutionGraph()
+                                        .getCheckpointCoordinatorConfiguration(),
+                        singleThreadMainThreadExecutor)
+                .get();
+    }
+
     private static JobGraph createJobGraph() {
         return streamingJobGraph(JOB_VERTEX);
     }
