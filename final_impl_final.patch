+        assertThat(refreshed.getCheckpointInterval()).isEqualTo(2_000L);
+        assertThat(refreshed.getCheckpointIntervalDuringBacklog()).isEqualTo(2_000L);
+        assertThat(refreshed.getCheckpointTimeout()).isEqualTo(30_000L);
+        assertThat(refreshed.getMinPauseBetweenCheckpoints()).isEqualTo(500L);
+        assertThat(refreshed.getMaxConcurrentCheckpoints()).isEqualTo(3);
+        assertThat(refreshed.getTolerableCheckpointFailureNumber()).isEqualTo(7);
+        assertThat(refreshed.getAlignedCheckpointTimeout()).isEqualTo(250L);
+
+        assertThat(refreshed.getCheckpointRetentionPolicy())
+                .isEqualTo(original.getCheckpointRetentionPolicy());
+        assertThat(refreshed.isExactlyOnce()).isEqualTo(original.isExactlyOnce());
+        assertThat(refreshed.isUnalignedCheckpointsEnabled())
+                .isEqualTo(original.isUnalignedCheckpointsEnabled());
+        assertThat(refreshed.getCheckpointIdOfIgnoredInFlightData()).isEqualTo(42L);
+        assertThat(refreshed.isEnableCheckpointsAfterTasksFinish()).isTrue();
+    }
