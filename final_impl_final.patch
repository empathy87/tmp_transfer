+/** Validates a {@link CheckpointConfigurationState} before it is put in force. */
+public final class CheckpointConfigurationStateValidator {
+
+    private CheckpointConfigurationStateValidator() {}
+
+    public static void validate(
+            CheckpointConfigurationState state, boolean unalignedCheckpointsEnabled) {
+        final long interval = state.getCheckpointInterval();
+        final long intervalDuringBacklog = state.getCheckpointIntervalDuringBacklog();
+        final int maxConcurrent = state.getMaxConcurrentCheckpoints();
+
+        requireAtLeast(interval, MINIMAL_CHECKPOINT_TIME, CHECKPOINTING_INTERVAL, "ms");
+        if (interval == DISABLED_CHECKPOINT_INTERVAL) {
+            throw new InvalidCheckpointConfigurationException(
+                    String.format(
+                            "'%s' must not be set to %d ms, which disables periodic checkpointing. "
+                                    + "Periodic checkpointing cannot be disabled through a live "
+                                    + "checkpoint configuration update.",
+                            CHECKPOINTING_INTERVAL.key(), DISABLED_CHECKPOINT_INTERVAL));
+        }
+        requireAtLeast(
+                state.getCheckpointTimeout(), MINIMAL_CHECKPOINT_TIME, CHECKPOINTING_TIMEOUT, "ms");
+        requireNonNegative(
+                state.getMinPauseBetweenCheckpoints(), MIN_PAUSE_BETWEEN_CHECKPOINTS, "ms");
+        requireAtLeast(maxConcurrent, 1, MAX_CONCURRENT_CHECKPOINTS, "");
+        requireNonNegative(
+                state.getTolerableCheckpointFailureNumber(), TOLERABLE_FAILURE_NUMBER, "");
+        requireNonNegative(state.getAlignedCheckpointTimeout(), ALIGNED_CHECKPOINT_TIMEOUT, "ms");
