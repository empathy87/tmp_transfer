+        }
+        return ExceptionUtils.findThrowable(
+                        catchThrowable(request::join), CheckpointException.class)
+                .map(CheckpointException::getCheckpointFailureReason)
+                .filter(
+                        reason ->
+                                reason == CheckpointFailureReason.MINIMUM_TIME_BETWEEN_CHECKPOINTS)
+                .isPresent();
+    }
