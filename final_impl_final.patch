+    @Override
+    public void applyCheckpointConfigUpdate(CheckpointConfigUpdate update) {
+        mainThreadExecutor.assertRunningInMainThread();
+        requireRunningJob();
+        requireCheckpointCoordinator().applyCheckpointConfigUpdate(update);
+        // Keep the reported configuration in sync.
+        executionGraph.refreshCheckpointCoordinatorConfiguration();
+    }
+
+    private void requireRunningJob() {
+        final JobStatus jobStatus = executionGraph.getState();
+        if (jobStatus != JobStatus.RUNNING) {
+            throw new JobNotExecutingException(
+                    String.format(
+                            "Cannot update the checkpoint configuration because the job is not currently "
+                                    + "executing (state: %s). Retry once the job is running.",
+                            jobStatus));
+        }
+    }
+
+    private CheckpointCoordinator requireCheckpointCoordinator() {
+        final CheckpointCoordinator checkpointCoordinator = getCheckpointCoordinator();
+        if (checkpointCoordinator == null) {
+            throw new CheckpointingNotEnabledException(
+                    "Cannot update the checkpoint configuration because checkpointing is not enabled for this job.");
+        }
+        return checkpointCoordinator;
