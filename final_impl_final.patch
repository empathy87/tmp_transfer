+            throw new InvalidCheckpointConfigurationException(
+                    String.format(
+                            "'%s' must be 1 while unaligned checkpoints are enabled, but was %d. "
+                                    + "Flink does not support concurrent unaligned checkpoints.",
+                            MAX_CONCURRENT_CHECKPOINTS.key(), maxConcurrent));
+        }
+    }
+
+    private static void requireAtLeast(long value, long min, ConfigOption<?> option, String unit) {
+        if (value < min) {
+            final String suffix = unit.isEmpty() ? "" : " " + unit;
+            throw new InvalidCheckpointConfigurationException(
+                    String.format(
+                            "'%s' must be at least %d%s, but was %d%s.",
+                            option.key(), min, suffix, value, suffix));
