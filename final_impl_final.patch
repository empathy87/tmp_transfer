+package org.apache.flink.runtime.checkpoint;
+
+import javax.annotation.Nullable;
+
+import java.io.Serializable;
+import java.util.Objects;
+import java.util.Optional;
+
+/** A partial checkpoint configuration update; absent fields keep their current value. */
+public final class CheckpointConfigUpdate implements Serializable {
+
+    private static final long serialVersionUID = 1L;
+
+    @Nullable private final Long checkpointInterval;
+
+    @Nullable private final Long checkpointIntervalDuringBacklog;
+
+    @Nullable private final Long checkpointTimeout;
+
+    @Nullable private final Long minPauseBetweenCheckpoints;
+
+    @Nullable private final Integer maxConcurrentCheckpoints;
+
+    @Nullable private final Integer tolerableCheckpointFailureNumber;
+
+    @Nullable private final Long alignedCheckpointTimeout;
+
+    private CheckpointConfigUpdate(
+            @Nullable Long checkpointInterval,
+            @Nullable Long checkpointIntervalDuringBacklog,
+            @Nullable Long checkpointTimeout,
+            @Nullable Long minPauseBetweenCheckpoints,
+            @Nullable Integer maxConcurrentCheckpoints,
+            @Nullable Integer tolerableCheckpointFailureNumber,
+            @Nullable Long alignedCheckpointTimeout) {
+        this.checkpointInterval = checkpointInterval;
+        this.checkpointIntervalDuringBacklog = checkpointIntervalDuringBacklog;
+        this.checkpointTimeout = checkpointTimeout;
+        this.minPauseBetweenCheckpoints = minPauseBetweenCheckpoints;
+        this.maxConcurrentCheckpoints = maxConcurrentCheckpoints;
+        this.tolerableCheckpointFailureNumber = tolerableCheckpointFailureNumber;
+        this.alignedCheckpointTimeout = alignedCheckpointTimeout;
+    }
+
+    public Optional<Long> getCheckpointInterval() {
+        return Optional.ofNullable(checkpointInterval);
+    }
+
+    public Optional<Long> getCheckpointIntervalDuringBacklog() {
+        return Optional.ofNullable(checkpointIntervalDuringBacklog);
+    }
+
+    public Optional<Long> getCheckpointTimeout() {
+        return Optional.ofNullable(checkpointTimeout);
+    }
+
+    public Optional<Long> getMinPauseBetweenCheckpoints() {
+        return Optional.ofNullable(minPauseBetweenCheckpoints);
+    }
+
+    public Optional<Integer> getMaxConcurrentCheckpoints() {
+        return Optional.ofNullable(maxConcurrentCheckpoints);
+    }
+
+    public Optional<Integer> getTolerableCheckpointFailureNumber() {
+        return Optional.ofNullable(tolerableCheckpointFailureNumber);
+    }
+
+    public Optional<Long> getAlignedCheckpointTimeout() {
+        return Optional.ofNullable(alignedCheckpointTimeout);
+    }
+
+    public static Builder builder() {
+        return new Builder();
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (o == null || getClass() != o.getClass()) {
+            return false;
+        }
+        final CheckpointConfigUpdate that = (CheckpointConfigUpdate) o;
+        return Objects.equals(checkpointInterval, that.checkpointInterval)
+                && Objects.equals(
+                        checkpointIntervalDuringBacklog, that.checkpointIntervalDuringBacklog)
+                && Objects.equals(checkpointTimeout, that.checkpointTimeout)
+                && Objects.equals(minPauseBetweenCheckpoints, that.minPauseBetweenCheckpoints)
+                && Objects.equals(maxConcurrentCheckpoints, that.maxConcurrentCheckpoints)
+                && Objects.equals(
+                        tolerableCheckpointFailureNumber, that.tolerableCheckpointFailureNumber)
+                && Objects.equals(alignedCheckpointTimeout, that.alignedCheckpointTimeout);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(
+                checkpointInterval,
+                checkpointIntervalDuringBacklog,
+                checkpointTimeout,
+                minPauseBetweenCheckpoints,
+                maxConcurrentCheckpoints,
+                tolerableCheckpointFailureNumber,
+                alignedCheckpointTimeout);
+    }
+
+    @Override
+    public String toString() {
+        return "CheckpointConfigUpdate{"
+                + "checkpointInterval="
+                + checkpointInterval
+                + ", checkpointIntervalDuringBacklog="
+                + checkpointIntervalDuringBacklog
+                + ", checkpointTimeout="
+                + checkpointTimeout
+                + ", minPauseBetweenCheckpoints="
+                + minPauseBetweenCheckpoints
+                + ", maxConcurrentCheckpoints="
+                + maxConcurrentCheckpoints
+                + ", tolerableCheckpointFailureNumber="
+                + tolerableCheckpointFailureNumber
+                + ", alignedCheckpointTimeout="
+                + alignedCheckpointTimeout
+                + '}';
+    }
+
+    /** Builder for {@link CheckpointConfigUpdate}. */
+    public static final class Builder {
+
+        @Nullable private Long checkpointInterval;
+        @Nullable private Long checkpointIntervalDuringBacklog;
+        @Nullable private Long checkpointTimeout;
+        @Nullable private Long minPauseBetweenCheckpoints;
+        @Nullable private Integer maxConcurrentCheckpoints;
+        @Nullable private Integer tolerableCheckpointFailureNumber;
+        @Nullable private Long alignedCheckpointTimeout;
+
+        private Builder() {}
+
+        public Builder setCheckpointInterval(@Nullable Long checkpointInterval) {
+            this.checkpointInterval = checkpointInterval;
+            return this;
+        }
+
+        public Builder setCheckpointIntervalDuringBacklog(
+                @Nullable Long checkpointIntervalDuringBacklog) {
+            this.checkpointIntervalDuringBacklog = checkpointIntervalDuringBacklog;
+            return this;
+        }
+
+        public Builder setCheckpointTimeout(@Nullable Long checkpointTimeout) {
+            this.checkpointTimeout = checkpointTimeout;
+            return this;
+        }
+
+        public Builder setMinPauseBetweenCheckpoints(@Nullable Long minPauseBetweenCheckpoints) {
+            this.minPauseBetweenCheckpoints = minPauseBetweenCheckpoints;
+            return this;
+        }
+
+        public Builder setMaxConcurrentCheckpoints(@Nullable Integer maxConcurrentCheckpoints) {
+            this.maxConcurrentCheckpoints = maxConcurrentCheckpoints;
+            return this;
+        }
+
+        public Builder setTolerableCheckpointFailureNumber(
+                @Nullable Integer tolerableCheckpointFailureNumber) {
+            this.tolerableCheckpointFailureNumber = tolerableCheckpointFailureNumber;
+            return this;
+        }
+
+        public Builder setAlignedCheckpointTimeout(@Nullable Long alignedCheckpointTimeout) {
+            this.alignedCheckpointTimeout = alignedCheckpointTimeout;
+            return this;
+        }
+
+        public CheckpointConfigUpdate build() {
+            return new CheckpointConfigUpdate(
+                    checkpointInterval,
+                    checkpointIntervalDuringBacklog,
+                    checkpointTimeout,
+                    minPauseBetweenCheckpoints,
+                    maxConcurrentCheckpoints,
+                    tolerableCheckpointFailureNumber,
+                    alignedCheckpointTimeout);
+        }
+    }
+}
