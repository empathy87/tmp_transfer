+import org.apache.flink.runtime.rest.messages.checkpoints.CheckpointConfigUpdateRequestBody;
+import org.apache.flink.runtime.scheduler.JobNotExecutingException;
+import org.apache.flink.runtime.scheduler.UnsupportedSchedulerException;
+import org.apache.flink.runtime.webmonitor.RestfulGateway;
+import org.apache.flink.runtime.webmonitor.retriever.GatewayRetriever;
+import org.apache.flink.util.ExceptionUtils;
+
+import javax.annotation.Nonnull;
+import javax.annotation.Nullable;
+
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+import static java.util.stream.Collectors.joining;
+import static org.apache.flink.configuration.CheckpointingOptions.ALIGNED_CHECKPOINT_TIMEOUT;
+import static org.apache.flink.configuration.CheckpointingOptions.CHECKPOINTING_INTERVAL;
+import static org.apache.flink.configuration.CheckpointingOptions.CHECKPOINTING_INTERVAL_DURING_BACKLOG;
+import static org.apache.flink.configuration.CheckpointingOptions.CHECKPOINTING_TIMEOUT;
+import static org.apache.flink.configuration.CheckpointingOptions.MAX_CONCURRENT_CHECKPOINTS;
+import static org.apache.flink.configuration.CheckpointingOptions.MIN_PAUSE_BETWEEN_CHECKPOINTS;
+import static org.apache.flink.configuration.CheckpointingOptions.TOLERABLE_FAILURE_NUMBER;
+import static org.apache.flink.configuration.Configuration.fromMap;
+import static org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus.BAD_REQUEST;
+import static org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus.CONFLICT;
+import static org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus.NOT_FOUND;
+import static org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus.NOT_IMPLEMENTED;
+import static org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus.SERVICE_UNAVAILABLE;
+import static org.apache.flink.util.ExceptionUtils.findThrowable;
+
+/** Handler for updating checkpoint configuration. */
+public class CheckpointConfigUpdateHandler
+        extends AbstractRestHandler<
+                RestfulGateway,
+                CheckpointConfigUpdateRequestBody,
+                EmptyResponseBody,
+                JobMessageParameters> {
+
+    private static final Set<String> LIVE_UPDATABLE_CONFIG_KEYS =
+            new LinkedHashSet<>(
+                    Arrays.asList(
+                            CHECKPOINTING_INTERVAL.key(),
+                            CHECKPOINTING_INTERVAL_DURING_BACKLOG.key(),
+                            CHECKPOINTING_TIMEOUT.key(),
+                            MIN_PAUSE_BETWEEN_CHECKPOINTS.key(),
+                            MAX_CONCURRENT_CHECKPOINTS.key(),
+                            TOLERABLE_FAILURE_NUMBER.key(),
+                            ALIGNED_CHECKPOINT_TIMEOUT.key()));
+
+    private static final String LIVE_UPDATABLE_CONFIG_KEYS_TEXT =
+            LIVE_UPDATABLE_CONFIG_KEYS.stream().sorted().collect(joining(", "));
+
+    public CheckpointConfigUpdateHandler(
+            GatewayRetriever<? extends RestfulGateway> leaderRetriever,
+            Time timeout,
+            Map<String, String> responseHeaders) {
+        super(leaderRetriever, timeout, responseHeaders, CheckpointConfigUpdateHeaders.INSTANCE);
+    }
+
+    @Override
+    protected CompletableFuture<EmptyResponseBody> handleRequest(
+            @Nonnull HandlerRequest<CheckpointConfigUpdateRequestBody> request,
+            @Nonnull RestfulGateway gateway)
+            throws RestHandlerException {
+        final JobID jobId = request.getPathParameter(JobIDPathParameter.class);
+        final CheckpointConfigUpdate update;
+        try {
+            update = parseUpdate(request.getRequestBody().getConfiguration());
+        } catch (InvalidCheckpointConfigurationException e) {
+            throw toBadRequest(e);
+        }
+
+        return gateway.updateCheckpointConfiguration(jobId, update)
+                .handle(
+                        (ignored, throwable) -> {
+                            if (throwable != null) {
+                                throw new CompletionException(mapToRestException(throwable));
+                            }
+                            return EmptyResponseBody.getInstance();
+                        });
+    }
+
+    private static CheckpointConfigUpdate parseUpdate(Map<String, String> config) {
+        if (config.isEmpty()) {
+            throw new InvalidCheckpointConfigurationException(
+                    "At least one checkpoint configuration key must be provided.");
+        }
+        for (Map.Entry<String, String> entry : config.entrySet()) {
+            if (!LIVE_UPDATABLE_CONFIG_KEYS.contains(entry.getKey())) {
+                throw new InvalidCheckpointConfigurationException(
+                        "Configuration key '"
+                                + entry.getKey()
+                                + "' is not supported for live checkpoint updates. Allowed keys are: "
+                                + LIVE_UPDATABLE_CONFIG_KEYS_TEXT);
+            }
+            if (entry.getValue() == null) {
+                throw new InvalidCheckpointConfigurationException(
+                        "The value of checkpoint configuration key '"
+                                + entry.getKey()
+                                + "' must not be null.");
+            }
+        }
+        try {
+            return toCheckpointConfigUpdate(fromMap(config));
+        } catch (IllegalArgumentException | ArithmeticException e) {
+            throw new InvalidCheckpointConfigurationException(
+                    "Invalid checkpoint configuration value: " + e.getMessage(), e);
+        }
+    }
+
+    private static CheckpointConfigUpdate toCheckpointConfigUpdate(Configuration config) {
+        return CheckpointConfigUpdate.builder()
+                .setCheckpointInterval(durationMillis(config, CHECKPOINTING_INTERVAL))
+                .setCheckpointIntervalDuringBacklog(
+                        durationMillis(config, CHECKPOINTING_INTERVAL_DURING_BACKLOG))
+                .setCheckpointTimeout(durationMillis(config, CHECKPOINTING_TIMEOUT))
+                .setMinPauseBetweenCheckpoints(
+                        durationMillis(config, MIN_PAUSE_BETWEEN_CHECKPOINTS))
+                .setMaxConcurrentCheckpoints(
+                        config.getOptional(MAX_CONCURRENT_CHECKPOINTS).orElse(null))
+                .setTolerableCheckpointFailureNumber(
+                        config.getOptional(TOLERABLE_FAILURE_NUMBER).orElse(null))
+                .setAlignedCheckpointTimeout(durationMillis(config, ALIGNED_CHECKPOINT_TIMEOUT))
+                .build();
+    }
+
+    private static Throwable mapToRestException(Throwable throwable) {
+        final Throwable cause = ExceptionUtils.stripCompletionException(throwable);
+        // Carries its own status, e.g. the disabled feature flag rejected by the Dispatcher.
+        final Optional<RestHandlerException> restHandlerException =
+                findThrowable(cause, RestHandlerException.class);
+        if (restHandlerException.isPresent()) {
+            return restHandlerException.get();
+        }
+        final Optional<InvalidCheckpointConfigurationException> invalidConfiguration =
+                findThrowable(cause, InvalidCheckpointConfigurationException.class);
+        if (invalidConfiguration.isPresent()) {
+            return toBadRequest(invalidConfiguration.get());
+        }
+        if (findThrowable(cause, FlinkJobNotFoundException.class).isPresent()) {
+            return new RestHandlerException("Job not found.", NOT_FOUND, cause);
+        }
+        // Checkpointing being disabled is a job-state conflict, not an invalid parameter.
+        final Optional<CheckpointingNotEnabledException> checkpointingNotEnabled =
+                findThrowable(cause, CheckpointingNotEnabledException.class);
+        if (checkpointingNotEnabled.isPresent()) {
+            return new RestHandlerException(
+                    checkpointingNotEnabled.get().getMessage(), CONFLICT, cause);
+        }
+        final Optional<JobNotExecutingException> notExecuting =
+                findThrowable(cause, JobNotExecutingException.class);
+        if (notExecuting.isPresent()) {
+            return new RestHandlerException(notExecuting.get().getMessage(), CONFLICT, cause);
+        }
+        if (findThrowable(cause, UnavailableDispatcherOperationException.class).isPresent()) {
+            return new RestHandlerException(
+                    "The job is still initializing. Please retry.", SERVICE_UNAVAILABLE, cause);
+        }
+        final Optional<UnsupportedSchedulerException> unsupported =
+                findThrowable(cause, UnsupportedSchedulerException.class);
+        if (unsupported.isPresent()) {
+            return new RestHandlerException(unsupported.get().getMessage(), NOT_IMPLEMENTED, cause);
+        }
+        // Generic argument and unsupported-operation errors may be internal failures.
+        return cause;
+    }
+
+    private static RestHandlerException toBadRequest(InvalidCheckpointConfigurationException e) {
+        return new RestHandlerException(e.getMessage(), BAD_REQUEST, e);
+    }
+
+    @Nullable
+    private static Long durationMillis(Configuration configuration, ConfigOption<Duration> option) {
+        return configuration.getOptional(option).map(Duration::toMillis).orElse(null);
+    }
+}
