+/** Tests for {@link CheckpointConfigurationState}. */
+class CheckpointConfigurationStateTest {
+
+    private static final long ONE_YEAR_MILLIS = 365L * 24 * 60 * 60 * 1_000;
+
+    private static CheckpointConfigurationState state(
+            long interval, long intervalDuringBacklog, long minPause) {
+        return CheckpointConfigurationState.fromCheckpointCoordinatorConfiguration(
+                CheckpointCoordinatorConfiguration.builder()
+                        .setCheckpointInterval(interval)
+                        .setCheckpointIntervalDuringBacklog(intervalDuringBacklog)
+                        .setCheckpointTimeout(600_000L)
+                        .setMinPauseBetweenCheckpoints(minPause)
+                        .setMaxConcurrentCheckpoints(1)
+                        .setAlignedCheckpointTimeout(0L)
+                        .build(),
+                0);
+    }
+
+    @Test
+    void testUpdateOverlaysOnlyTheFieldsItNames() {
+        final CheckpointConfigurationState before = state(1_000L, 1_000L, 0L);
+
+        final CheckpointConfigurationState after =
+                before.withUpdate(
+                        CheckpointConfigUpdate.builder().setCheckpointTimeout(9_000L).build());
+
+        assertThat(after.getCheckpointTimeout()).isEqualTo(9_000L);
+        assertThat(after.getCheckpointInterval()).isEqualTo(before.getCheckpointInterval());
+        assertThat(after.getMinPauseBetweenCheckpoints())
+                .isEqualTo(before.getMinPauseBetweenCheckpoints());
+        assertThat(after.getMaxConcurrentCheckpoints())
+                .isEqualTo(before.getMaxConcurrentCheckpoints());
+        assertThat(after.getTolerableCheckpointFailureNumber())
+                .isEqualTo(before.getTolerableCheckpointFailureNumber());
+        assertThat(after.getAlignedCheckpointTimeout())
+                .isEqualTo(before.getAlignedCheckpointTimeout());
+    }
+
+    @Test
+    void testEmptyUpdateIsANoOp() {
+        final CheckpointConfigurationState before = state(1_000L, 1_000L, 0L);
+
+        assertThat(before.withUpdate(CheckpointConfigUpdate.builder().build())).isEqualTo(before);
+    }
+
+    @Test
+    void testEffectiveIntervalIsRaisedToTheMinimumPause() {
+        final CheckpointConfigurationState state =
+                state(1_000L, 1_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setMinPauseBetweenCheckpoints(10_000L)
+                                        .build());
+
+        assertThat(state.getCheckpointInterval()).isEqualTo(1_000L);
+        assertThat(state.effectiveCheckpointInterval()).isEqualTo(10_000L);
+    }
+
+    @Test
+    void testEffectiveIntervalIsRecomputedFromTheConfiguredInterval() {
+        final CheckpointConfigurationState raised =
+                state(1_000L, 1_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setMinPauseBetweenCheckpoints(10_000L)
+                                        .build());
+
+        final CheckpointConfigurationState lowered =
+                raised.withUpdate(
+                        CheckpointConfigUpdate.builder().setMinPauseBetweenCheckpoints(0L).build());
+
+        assertThat(lowered.effectiveCheckpointInterval()).isEqualTo(1_000L);
+    }
+
+    @Test
+    void testHugeMinimumPauseIsCappedAtOneYear() {
+        final CheckpointConfigurationState updated =
+                state(1_000L, 1_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setMinPauseBetweenCheckpoints(Long.MAX_VALUE)
+                                        .build());
+
+        assertThat(updated.getMinPauseBetweenCheckpoints()).isEqualTo(ONE_YEAR_MILLIS);
+        assertThat(updated).isEqualTo(state(1_000L, 1_000L, Long.MAX_VALUE));
+    }
+
+    @Test
+    void testZeroBacklogIntervalDisablesBacklogCheckpoints() {
+        final CheckpointConfigurationState updated =
+                state(1_000L, 5_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setCheckpointIntervalDuringBacklog(0L)
+                                        .build());
+
+        assertThat(updated.getCheckpointIntervalDuringBacklog())
+                .isEqualTo(DISABLED_CHECKPOINT_INTERVAL);
+    }
+
+    @Test
+    void testOmittedBacklogIntervalIsRaisedToAHigherRegularInterval() {
+        final CheckpointConfigurationState updated =
+                state(1_000L, 5_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setCheckpointInterval(7_000L)
+                                        .build());
+
+        assertThat(updated.getCheckpointIntervalDuringBacklog()).isEqualTo(7_000L);
+    }
+
+    @Test
+    void testDisabledBacklogIntervalStaysDisabledWhenTheIntervalRises() {
+        final CheckpointConfigurationState disabled =
+                state(1_000L, 5_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setCheckpointIntervalDuringBacklog(0L)
+                                        .build());
+
+        final CheckpointConfigurationState updated =
+                disabled.withUpdate(
+                        CheckpointConfigUpdate.builder().setCheckpointInterval(7_000L).build());
+
+        assertThat(updated.getCheckpointIntervalDuringBacklog())
+                .isEqualTo(DISABLED_CHECKPOINT_INTERVAL);
+    }
+
+    @Test
+    void testExplicitBacklogIntervalIsKeptUnchanged() {
+        final CheckpointConfigurationState updated =
+                state(1_000L, 5_000L, 0L)
+                        .withUpdate(
+                                CheckpointConfigUpdate.builder()
+                                        .setCheckpointInterval(2_000L)
+                                        .setCheckpointIntervalDuringBacklog(5_000L)
+                                        .build());
+
+        assertThat(updated.getCheckpointIntervalDuringBacklog()).isEqualTo(5_000L);
+    }
+
+    @Test
+    void testApplyToUpdatesLiveFieldsAndPreservesTheOthers() {
+        final CheckpointCoordinatorConfiguration original =
+                CheckpointCoordinatorConfiguration.builder()
+                        .setCheckpointInterval(1_000L)
+                        .setCheckpointIntervalDuringBacklog(1_000L)
+                        .setCheckpointTimeout(600_000L)
+                        .setMinPauseBetweenCheckpoints(0L)
+                        .setMaxConcurrentCheckpoints(1)
+                        .setTolerableCheckpointFailureNumber(0)
