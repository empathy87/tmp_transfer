+    /** A timeout is a duration, so a wall-clock jump must not shorten or extend it. */
+    @Test
+    void testWallClockJumpsDoNotAffectTheRemainingTimeout() throws Exception {
+        final RecordingScheduledExecutor timer = new RecordingScheduledExecutor();
+        // ManualClock cannot vary wall-clock and monotonic time independently.
+        final DivergingClock clock = new DivergingClock();
+        final CheckpointCoordinator coordinator = coordinator(600_000, 600_000, 0, timer, clock);
+
+        coordinator.triggerCheckpoint(false);
+        timer.triggerAll();
+        assertThat(coordinator.getNumberOfPendingCheckpoints()).isEqualTo(1);
+
+        clock.advanceRelativeTime(Duration.ofSeconds(10));
+        // Meanwhile NTP steps the wall clock an hour backwards, then someone sets it two forwards.
+        clock.jumpAbsoluteTime(Duration.ofHours(-1));
+        clock.jumpAbsoluteTime(Duration.ofHours(2));
+
+        coordinator.applyCheckpointConfigUpdate(
+                CheckpointConfigUpdate.builder().setCheckpointTimeout(100_000L).build());
+
+        assertThat(timer.lastScheduledCancellerDelayMillis())
+                .as("only the 10s of monotonic time that actually elapsed may be charged")
+                .isEqualTo(90_000L);
+        assertThat(coordinator.getNumberOfPendingCheckpoints())
+                .as("and no wall-clock jump may expire a checkpoint")
+                .isEqualTo(1);
+    }
