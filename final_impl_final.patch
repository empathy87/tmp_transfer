+        implements RuntimeMessageHeaders<
+                CheckpointConfigUpdateRequestBody, EmptyResponseBody, JobMessageParameters> {
+
+    public static final CheckpointConfigUpdateHeaders INSTANCE =
+            new CheckpointConfigUpdateHeaders();
+
+    public static final String URL =
+            "/jobs/:" + JobIDPathParameter.KEY + "/checkpoints/configuration";
+
+    private CheckpointConfigUpdateHeaders() {}
+
+    @Override
+    public Class<CheckpointConfigUpdateRequestBody> getRequestClass() {
+        return CheckpointConfigUpdateRequestBody.class;
+    }
+
+    @Override
+    public Class<EmptyResponseBody> getResponseClass() {
+        return EmptyResponseBody.class;
+    }
+
+    @Override
+    public HttpResponseStatus getResponseStatusCode() {
+        return HttpResponseStatus.OK;
+    }
+
+    @Override
+    public JobMessageParameters getUnresolvedMessageParameters() {
+        return new JobMessageParameters();
+    }
+
+    @Override
+    public HttpMethodWrapper getHttpMethod() {
+        return HttpMethodWrapper.PATCH;
+    }
+
+    @Override
+    public String getTargetRestEndpointURL() {
+        return URL;
+    }
+
+    @Override
+    public String getDescription() {
+        return "Updates the checkpoint configuration of the currently running job without a restart. "
+                + "The update is not persisted and may be lost after JobManager failover. The body "
+                + "carries a 'configuration' map of execution.checkpointing.* keys to values, in the "
+                + "same form used in config.yaml or a SQL SET statement (durations may use a unit "
+                + "suffix such as '5 s'). Keys left out are unchanged, except that the backlog "
+                + "interval may be raised when the regular checkpoint interval is increased. "
+                + "A shorter interval may move the next periodic checkpoint earlier, while a longer "
+                + "interval does not delay an already scheduled one, so one more checkpoint may "
+                + "still run on the previous schedule.";
+    }
+
+    @Override
+    public String operationId() {
+        return "updateCheckpointConfiguration";
+    }
+}
