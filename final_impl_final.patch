+    private static JobID submitInfiniteCheckpointingJob(RestClusterClient<?> restClusterClient) {
+        final StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();
+        env.setParallelism(1);
+        env.enableCheckpointing(30_000L);
+        env.addSource(new InfiniteSource()).addSink(new DiscardingSink<>());
+
+        final JobGraph jobGraph = env.getStreamGraph().getJobGraph();
+        final JobID jobId = jobGraph.getJobID();
+        restClusterClient.submitJob(jobGraph).join();
+        return jobId;
+    }
+
+    /** Task counts cannot tell "never restarted" from "restarted", so compare attempt identity. */
+    private static void assertStaysRunningWithoutRestart(
+            RestClusterClient<?> restClusterClient, JobID jobId, Set<String> attemptsBefore)
+            throws Exception {
+        for (int i = 0; i < 10; i++) {
+            assertThat(restClusterClient.getJobStatus(jobId).get()).isEqualTo(JobStatus.RUNNING);
+            assertThat(runningAttempts(restClusterClient, jobId))
+                    .as("a live update must not redeploy any task")
+                    .isEqualTo(attemptsBefore);
+            Thread.sleep(50L);
+        }
+    }
+
+    /** Polls because ExecutionGraphCache may briefly serve the previous configuration. */
+    private static JsonNode awaitCheckpointConfig(
+            RestClusterClient<?> client, JobID jobId, Predicate<JsonNode> until) throws Exception {
+        final AtomicReference<JsonNode> latest = new AtomicReference<>();
+        CommonTestUtils.waitUntilCondition(
+                () -> {
+                    final JsonNode reported = effectiveCheckpointConfig(client, jobId);
+                    latest.set(reported);
+                    return until.test(reported);
+                });
+        return latest.get();
+    }
+
+    /**
+     * Reads the reported configuration as JSON, since {@link CheckpointConfigInfo} has no getters.
+     */
+    private static JsonNode effectiveCheckpointConfig(RestClusterClient<?> client, JobID jobId)
+            throws Exception {
+        final CheckpointConfigInfo info =
+                client.sendRequest(
+                                CheckpointConfigHeaders.getInstance(),
+                                new JobMessageParameters() {
+                                    {
+                                        jobPathParameter.resolve(jobId);
+                                    }
+                                },
+                                EmptyRequestBody.getInstance())
+                        .get();
+        return RestMapperUtils.getStrictObjectMapper().valueToTree(info);
+    }
+
+    /** Returns {@code <vertexId>-<subtask>-<attemptNumber>} per running subtask. */
+    private static Set<String> runningAttempts(RestClusterClient<?> client, JobID jobId)
+            throws Exception {
+        final Set<String> attempts = new HashSet<>();
+        for (JobDetailsInfo.JobVertexDetailsInfo vertex :
+                client.sendRequest(
+                                JobDetailsHeaders.getInstance(),
+                                new JobMessageParameters() {
+                                    {
+                                        jobPathParameter.resolve(jobId);
+                                    }
+                                },
+                                EmptyRequestBody.getInstance())
+                        .get()
+                        .getJobVertexInfos()) {
+            final JobVertexDetailsInfo details =
+                    client.sendRequest(
+                                    JobVertexDetailsHeaders.getInstance(),
+                                    new JobVertexMessageParameters() {
+                                        {
+                                            jobPathParameter.resolve(jobId);
+                                            jobVertexIdPathParameter.resolve(
+                                                    vertex.getJobVertexID());
+                                        }
+                                    },
+                                    EmptyRequestBody.getInstance())
+                            .get();
+            for (SubtaskExecutionAttemptDetailsInfo subtask : details.getSubtasks()) {
+                if (subtask.getStatus() == ExecutionState.RUNNING) {
+                    attempts.add(
+                            vertex.getJobVertexID()
+                                    + "-"
+                                    + subtask.getSubtaskIndex()
+                                    + "-"
+                                    + subtask.getAttempt());
+                }
+            }
+        }
+        return attempts;
+    }
+
+    private static int runningTasks(RestClusterClient<?> client, JobID jobId) throws Exception {
+        return client.getJobDetails(jobId).get().getJobVertexInfos().stream()
+                .map(vertex -> vertex.getTasksPerState().getOrDefault(ExecutionState.RUNNING, 0))
+                .mapToInt(Integer::intValue)
+                .sum();
+    }
+
+    /** A source that keeps emitting until cancelled, so the job stays RUNNING for the test. */
+    private static final class InfiniteSource implements SourceFunction<Long> {
+
+        private static final long serialVersionUID = 1L;
+
+        private volatile boolean running = true;
+
+        @Override
+        public void run(SourceContext<Long> ctx) throws Exception {
+            long value = 0L;
+            while (running) {
+                synchronized (ctx.getCheckpointLock()) {
+                    ctx.collect(value++);
+                }
+                Thread.sleep(5L);
+            }
+        }
+
+        @Override
+        public void cancel() {
+            running = false;
+        }
+    }
