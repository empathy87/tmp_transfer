+    private CheckpointCoordinator coordinator(
+            long interval,
+            long timeout,
+            long minPause,
+            int maxConcurrentCheckpoints,
+            ScheduledExecutor timer,
+            @Nullable Clock clock,
+            @Nullable CheckpointFailureManager failureManager)
+            throws Exception {
+        final CheckpointCoordinatorConfiguration config =
+                new CheckpointCoordinatorConfigurationBuilder()
+                        .setCheckpointInterval(interval)
+                        .setCheckpointIntervalDuringBacklog(interval)
+                        .setCheckpointTimeout(timeout)
+                        .setMinPauseBetweenCheckpoints(minPause)
+                        .setMaxConcurrentCheckpoints(maxConcurrentCheckpoints)
+                        .build();
+        final CheckpointCoordinatorBuilder builder =
+                new CheckpointCoordinatorBuilder()
+                        .setCheckpointCoordinatorConfiguration(config)
+                        .setTimer(timer);
+        if (clock != null) {
