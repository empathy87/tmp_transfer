+
+    private static void requireNonNegative(long value, ConfigOption<?> option, String unit) {
+        if (value < 0) {
+            final String suffix = unit.isEmpty() ? "" : " " + unit;
+            throw new InvalidCheckpointConfigurationException(
+                    String.format(
+                            "'%s' must be non-negative, but was %d%s.",
+                            option.key(), value, suffix));
+        }
+    }
