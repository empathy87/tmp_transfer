+    /** A clock whose wall-clock and monotonic readings move independently. */
+    private static final class DivergingClock extends Clock {
+
+        private long absoluteMillis = 1_600_000_000_000L;
+        private long relativeMillis;
+
+        @Override
+        public long absoluteTimeMillis() {
+            return absoluteMillis;
+        }
+
+        @Override
+        public long relativeTimeMillis() {
+            return relativeMillis;
+        }
+
+        @Override
+        public long relativeTimeNanos() {
+            return relativeMillis * 1_000_000L;
+        }
+
+        void advanceRelativeTime(Duration duration) {
+            relativeMillis += duration.toMillis();
+            absoluteMillis += duration.toMillis();
+        }
+
+        void jumpAbsoluteTime(Duration duration) {
+            absoluteMillis += duration.toMillis();
+        }
+    }
+
+    /**
+     * Records cancellers and trigger delays, and can refuse a schedule or run a scheduled task
+     * synchronously inside {@code schedule()}.
+     */
+    private static class RecordingScheduledExecutor extends ManuallyTriggeredScheduledExecutor {
+
+        private final List<Runnable> cancellers = new ArrayList<>();
+        private final List<ScheduledFuture<?>> cancellerFutures = new ArrayList<>();
+        private final List<Long> triggerDelaysMillis = new ArrayList<>();
+        private final List<Long> cancellerDelaysMillis = new ArrayList<>();
+
+        private int triggerRejections;
+        private int cancellerRejections;
+        private int executeRejections;
+        private int refusedExecutions;
+        private int cancellerScheduleAttempts;
+        private boolean runCancellersInline;
+
+        @Override
+        public void execute(Runnable command) {
+            if (executeRejections > 0) {
+                executeRejections--;
+                refusedExecutions++;
+                throw new RejectedExecutionException("timer rejected the queued trigger request");
+            }
+            super.execute(command);
+        }
+
+        @Override
+        public ScheduledFuture<?> schedule(Runnable command, long delay, TimeUnit unit) {
+            // The coordinator schedules exactly two kinds of task on this timer: per-checkpoint
+            // timeout cancellers and the periodic trigger.
+            final boolean isCanceller = command.getClass().getSimpleName().contains("Canceller");
+            if (isCanceller) {
+                cancellerScheduleAttempts++;
+                if (cancellerRejections > 0) {
+                    cancellerRejections--;
+                    throw new RejectedExecutionException("timer rejected the timeout canceller");
+                }
+                cancellers.add(command);
+                cancellerDelaysMillis.add(unit.toMillis(delay));
+            } else {
+                if (triggerRejections > 0) {
+                    triggerRejections--;
+                    throw new RejectedExecutionException("timer rejected the periodic trigger");
+                }
+                triggerDelaysMillis.add(unit.toMillis(delay));
+            }
+            final ScheduledFuture<?> future = super.schedule(command, delay, unit);
+            if (isCanceller) {
+                cancellerFutures.add(future);
+                if (runCancellersInline) {
+                    command.run();
+                }
+            }
+            return future;
+        }
+
+        /** Makes the next schedules of each kind fail, the way a shutting-down timer does. */
+        void reject(int triggers, int cancellers) {
+            this.triggerRejections = triggers;
+            this.cancellerRejections = cancellers;
+        }
+
+        /** Rejects the next calls to {@code execute()}. */
+        void rejectExecutions(int executions) {
+            this.executeRejections = executions;
+        }
+
+        /** How often {@code execute()} was actually refused. */
+        int refusedExecutions() {
+            return refusedExecutions;
+        }
+
+        /** Runs every subsequently scheduled canceller before {@code schedule()} returns. */
+        void runCancellersInline(boolean runCancellersInline) {
+            this.runCancellersInline = runCancellersInline;
+        }
+
+        /** How often {@code schedule()} was asked for a canceller, including refused attempts. */
+        int cancellerScheduleAttempts() {
+            return cancellerScheduleAttempts;
+        }
+
+        List<Runnable> cancellersScheduledAfter(int index) {
+            return new ArrayList<>(cancellers.subList(index, cancellers.size()));
+        }
+
+        int scheduledCancellerCount() {
+            return cancellers.size();
+        }
+
+        @Nullable
+        Runnable lastScheduledCanceller() {
+            return cancellers.isEmpty() ? null : cancellers.get(cancellers.size() - 1);
+        }
+
+        /** Whether the n-th handle returned by {@code schedule()} was cancelled again. */
+        boolean cancellerWasCancelled(int index) {
+            return cancellerFutures.get(index).isCancelled();
+        }
+
+        /** Whether the handle most recently returned by {@code schedule()} was cancelled again. */
+        boolean lastScheduledCancellerWasCancelled() {
+            assertThat(cancellerFutures).as("no canceller was scheduled at all").isNotEmpty();
+            return cancellerFutures.get(cancellerFutures.size() - 1).isCancelled();
+        }
+
+        @Nullable
+        Long lastScheduledTriggerDelayMillis() {
+            return triggerDelaysMillis.isEmpty()
+                    ? null
+                    : triggerDelaysMillis.get(triggerDelaysMillis.size() - 1);
+        }
+
+        @Nullable
+        Long lastScheduledCancellerDelayMillis() {
+            return cancellerDelaysMillis.isEmpty()
+                    ? null
+                    : cancellerDelaysMillis.get(cancellerDelaysMillis.size() - 1);
+        }
+    }
+}
