+import org.apache.flink.util.concurrent.FutureUtils;
+
+import org.apache.flink.shaded.netty4.io.netty.handler.codec.http.HttpResponseStatus;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static java.util.Collections.singletonMap;
+import static org.apache.flink.configuration.CheckpointingOptions.ALIGNED_CHECKPOINT_TIMEOUT;
+import static org.apache.flink.configuration.CheckpointingOptions.CHECKPOINTING_INTERVAL;
+import static org.apache.flink.configuration.CheckpointingOptions.CHECKPOINTING_INTERVAL_DURING_BACKLOG;
+import static org.apache.flink.configuration.CheckpointingOptions.CHECKPOINTING_TIMEOUT;
+import static org.apache.flink.configuration.CheckpointingOptions.MAX_CONCURRENT_CHECKPOINTS;
+import static org.apache.flink.configuration.CheckpointingOptions.MIN_PAUSE_BETWEEN_CHECKPOINTS;
+import static org.apache.flink.configuration.CheckpointingOptions.TOLERABLE_FAILURE_NUMBER;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/** Tests for {@link CheckpointConfigUpdateHandler}. */
+class CheckpointConfigUpdateHandlerTest {
+
+    private static final String INTERVAL = CHECKPOINTING_INTERVAL.key();
+    private static final String INTERVAL_DURING_BACKLOG =
+            CHECKPOINTING_INTERVAL_DURING_BACKLOG.key();
+    private static final String TIMEOUT = CHECKPOINTING_TIMEOUT.key();
+    private static final String MIN_PAUSE = MIN_PAUSE_BETWEEN_CHECKPOINTS.key();
+    private static final String MAX_CONCURRENT = MAX_CONCURRENT_CHECKPOINTS.key();
+    private static final String TOLERABLE_FAILURES = TOLERABLE_FAILURE_NUMBER.key();
+    private static final String ALIGNED_TIMEOUT = ALIGNED_CHECKPOINT_TIMEOUT.key();
+
+    private static final Map<String, String> VALID_CONFIGURATION = singletonMap(INTERVAL, "5 s");
+
+    @ParameterizedTest
+    @ValueSource(
+            strings = {
+                "execution.checkpointing.not-a-real-key",
+                "execution.checkpointing.unaligned.enabled",
+                "execution.checkpointing.alignment-timeout"
+            })
+    void testKeyOutsideAllowListIsRejected(String key) {
+        assertInvalidConfiguration(singletonMap(key, "1 s"), "is not supported for live");
+    }
+
+    @Test
+    void testEmptyConfigurationIsRejected() {
+        assertInvalidConfiguration(Collections.emptyMap(), "At least one");
+    }
+
+    @Test
+    void testUnparseableValueIsRejected() {
+        assertInvalidConfiguration(singletonMap(INTERVAL, "not-a-duration"), "configuration value");
+    }
+
+    @Test
+    void testUnitSuffixedDurationIsParsed() {
+        final CheckpointConfigUpdate update = handleAndCaptureUpdate(singletonMap(INTERVAL, "5 s"));
+        assertThat(update.getCheckpointInterval()).hasValue(5_000L);
+    }
+
+    @Test
+    void testAbsentKeysAreLeftUnchanged() {
+        final CheckpointConfigUpdate update = handleAndCaptureUpdate(singletonMap(TIMEOUT, "30 s"));
+        assertThat(update.getCheckpointTimeout()).hasValue(30_000L);
+        assertThat(update.getCheckpointInterval()).isEmpty();
+        assertThat(update.getMaxConcurrentCheckpoints()).isEmpty();
+    }
+
+    @Test
+    void testAllParametersMapToTheCarrier() {
+        final Map<String, String> configuration = new HashMap<>();
+        configuration.put(INTERVAL, "1 s");
+        configuration.put(INTERVAL_DURING_BACKLOG, "2 s");
+        configuration.put(TIMEOUT, "60 s");
+        configuration.put(MIN_PAUSE, "500 ms");
+        configuration.put(MAX_CONCURRENT, "2");
+        configuration.put(TOLERABLE_FAILURES, "3");
+        configuration.put(ALIGNED_TIMEOUT, "10 s");
+
+        final CheckpointConfigUpdate update = handleAndCaptureUpdate(configuration);
+
+        assertThat(update.getCheckpointInterval()).hasValue(1_000L);
+        assertThat(update.getCheckpointIntervalDuringBacklog()).hasValue(2_000L);
+        assertThat(update.getCheckpointTimeout()).hasValue(60_000L);
+        assertThat(update.getMinPauseBetweenCheckpoints()).hasValue(500L);
+        assertThat(update.getMaxConcurrentCheckpoints()).hasValue(2);
+        assertThat(update.getTolerableCheckpointFailureNumber()).hasValue(3);
+        assertThat(update.getAlignedCheckpointTimeout()).hasValue(10_000L);
+    }
+
+    @Test
+    void testNullValueIsRejectedAsBadRequest() {
+        final Map<String, String> configuration = new HashMap<>();
+        configuration.put(INTERVAL, null);
+        assertInvalidConfiguration(configuration, "must not be null");
+    }
+
+    @Test
+    void testOverflowingDurationIsRejectedAsBadRequest() {
+        assertInvalidConfiguration(
+                singletonMap(INTERVAL, "9223372036854776 s"), "configuration value");
+    }
+
+    @Test
+    void testValidUpdateSucceeds() throws Exception {
+        final RestfulGateway gateway =
+                new TestingRestfulGateway() {
+                    @Override
+                    public CompletableFuture<Acknowledge> updateCheckpointConfiguration(
+                            JobID jobId, CheckpointConfigUpdate update) {
+                        return CompletableFuture.completedFuture(Acknowledge.get());
+                    }
+                };
+
+        assertThat(handleUpdate(gateway, VALID_CONFIGURATION))
+                .isSameAs(EmptyResponseBody.getInstance());
+    }
+
+    @Test
+    void testInvalidConfigurationFromGatewayBecomesBadRequest() {
+        assertGatewayFailureStatus(
+                new InvalidCheckpointConfigurationException("interval must be >= min-pause"),
+                HttpResponseStatus.BAD_REQUEST);
+    }
+
+    @Test
+    void testDisabledIntervalIsParsedAndRejectedAtRuntimeAsBadRequest() {
+        final Map<String, String> disabling =
+                singletonMap(
+                        INTERVAL,
+                        CheckpointCoordinatorConfiguration.DISABLED_CHECKPOINT_INTERVAL + " ms");
+
+        // The sentinel survives parsing; the coordinator's validator is what rejects it.
+        assertThat(handleAndCaptureUpdate(disabling).getCheckpointInterval())
+                .hasValue(CheckpointCoordinatorConfiguration.DISABLED_CHECKPOINT_INTERVAL);
+
+        final RestfulGateway gateway =
+                createFailingGateway(
+                        new InvalidCheckpointConfigurationException(
+                                "'"
+                                        + INTERVAL
+                                        + "' must not be set to 9223372036854775807 ms, which "
+                                        + "disables periodic checkpointing."));
+
+        assertThatThrownBy(() -> handleUpdate(gateway, disabling))
+                .cause()
+                .isInstanceOfSatisfying(
+                        RestHandlerException.class,
+                        e ->
+                                assertThat(e.getHttpResponseStatus())
+                                        .isEqualTo(HttpResponseStatus.BAD_REQUEST));
+    }
+
+    @Test
+    void testGenericIllegalArgumentIsNotConvertedToBadRequest() {
+        final IllegalArgumentException internalFault =
+                new IllegalArgumentException("internal programming error");
+        final RestfulGateway gateway = createFailingGateway(internalFault);
+
+        assertThatThrownBy(() -> handleUpdate(gateway, VALID_CONFIGURATION))
+                .cause()
+                .isSameAs(internalFault)
+                .isNotInstanceOf(RestHandlerException.class);
+    }
+
+    @Test
+    void testCheckpointingNotEnabledFromGatewayBecomesConflict() {
+        assertGatewayFailureStatus(
+                new CheckpointingNotEnabledException("checkpointing is not enabled for this job"),
+                HttpResponseStatus.CONFLICT);
+    }
+
+    @Test
+    void testJobNotExecutingFromGatewayBecomesConflict() {
+        assertGatewayFailureStatus(
+                new JobNotExecutingException("the job is not currently executing"),
+                HttpResponseStatus.CONFLICT);
+    }
+
+    @Test
+    void testUnknownGatewayFailureIsPropagatedUnchanged() {
+        final IllegalStateException internalFault = new IllegalStateException("should not happen");
+        final RestfulGateway gateway = createFailingGateway(internalFault);
+
+        assertThatThrownBy(() -> handleUpdate(gateway, VALID_CONFIGURATION))
+                .cause()
+                .isSameAs(internalFault);
+    }
+
+    @Test
+    void testJobNotFoundFromGatewayBecomesNotFound() {
+        assertGatewayFailureStatus(
+                new FlinkJobNotFoundException(new JobID()), HttpResponseStatus.NOT_FOUND);
+    }
+
+    @Test
+    void testDisabledFeatureFlagStaysForbidden() {
+        assertGatewayFailureStatus(
+                new RestHandlerException(
+                        "Dynamic job configuration is disabled.", HttpResponseStatus.FORBIDDEN),
+                HttpResponseStatus.FORBIDDEN);
+    }
+
+    @Test
+    void testRestHandlerExceptionFromGatewayIsPreserved() {
+        final RestHandlerException failure =
+                new RestHandlerException("disabled", HttpResponseStatus.FORBIDDEN);
+        final RestfulGateway gateway = createFailingGateway(failure);
+
+        assertThatThrownBy(() -> handleUpdate(gateway, VALID_CONFIGURATION))
+                .cause()
+                .isSameAs(failure);
+    }
+
+    @Test
+    void testWrappedCausesAreStillMapped() {
+        assertGatewayFailureStatus(
+                new CompletionException(
+                        new CheckpointingNotEnabledException("checkpointing is not enabled")),
+                HttpResponseStatus.CONFLICT);
