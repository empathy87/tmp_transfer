+                                        .setCheckpointTimeout(30_000L)
+                                        .setMinPauseBetweenCheckpoints(500L)
+                                        .setMaxConcurrentCheckpoints(3)
+                                        .setTolerableCheckpointFailureNumber(7)
+                                        .setAlignedCheckpointTimeout(250L)
+                                        .build())
+                        .applyTo(original);
