+    @Test
+    void testLiveUpdateOfAllParametersDoesNotRestartJob(
+            @InjectClusterClient RestClusterClient<?> restClusterClient,
+            @InjectMiniCluster MiniCluster miniCluster)
+            throws Exception {
+        final JobID jobId = submitInfiniteCheckpointingJob(restClusterClient);
+        try {
+            CommonTestUtils.waitUntilCondition(() -> runningTasks(restClusterClient, jobId) == 1);
+
+            // One update spanning every component: coordinator, request decider, failure manager.
+            final Map<String, String> fullUpdate = new HashMap<>();
+            fullUpdate.put("execution.checkpointing.interval", "1 s");
+            fullUpdate.put("execution.checkpointing.interval-during-backlog", "2 s");
+            fullUpdate.put("execution.checkpointing.timeout", "60 s");
+            fullUpdate.put("execution.checkpointing.min-pause", "500 ms"); // <= interval
+            fullUpdate.put("execution.checkpointing.max-concurrent-checkpoints", "2");
+            fullUpdate.put("execution.checkpointing.tolerable-failed-checkpoints", "3");
+            fullUpdate.put("execution.checkpointing.aligned-checkpoint-timeout", "10 s");
+            final Set<String> attemptsBefore = runningAttempts(restClusterClient, jobId);
+            assertThat(attemptsBefore).hasSize(1);
+
+            restClusterClient
+                    .updateCheckpointConfiguration(
+                            jobId, new CheckpointConfigUpdateRequestBody(fullUpdate))
+                    .get();
+
+            final JsonNode after =
+                    awaitCheckpointConfig(
+                            restClusterClient,
+                            jobId,
+                            node ->
+                                    node.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_INTERVAL)
+                                                    .asLong()
+                                            == 1_000L);
+            assertThat(after.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_TIMEOUT).asLong())
+                    .isEqualTo(60_000L);
+            assertThat(after.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_MIN_PAUSE).asLong())
+                    .isEqualTo(500L);
+            assertThat(
+                            after.get(CheckpointConfigInfo.FIELD_NAME_CHECKPOINT_MAX_CONCURRENT)
+                                    .asLong())
+                    .isEqualTo(2L);
+            assertThat(
+                            after.get(CheckpointConfigInfo.FIELD_NAME_TOLERABLE_FAILED_CHECKPOINTS)
+                                    .asInt())
+                    .isEqualTo(3);
+            assertThat(
+                            after.get(CheckpointConfigInfo.FIELD_NAME_ALIGNED_CHECKPOINT_TIMEOUT)
+                                    .asLong())
+                    .isEqualTo(10_000L);
+            // CheckpointConfigInfo carries no backlog-interval field, so read the reported
+            // configuration the graph exposes instead.
+            assertThat(
+                            miniCluster
+                                    .getExecutionGraph(jobId)
+                                    .get()
+                                    .getCheckpointCoordinatorConfiguration()
+                                    .getCheckpointIntervalDuringBacklog())
+                    .isEqualTo(2_000L);
+
+            assertStaysRunningWithoutRestart(restClusterClient, jobId, attemptsBefore);
+
+        } finally {
+            restClusterClient.cancel(jobId).join();
+        }
